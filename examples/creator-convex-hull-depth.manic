// Existing-Manic treatment of animations/fig0190.asy.
// A finite cloud makes the hull/depth question readable and exact.

title("Finding a Convex Hull");
canvas("9:16");
template("black");
creator(me,"@anish2good name=Manic_Data tagline=Algorithms_made_visible yt=zarigatongy x=@anish2good web=8gwifi.org/manic accent=cyan secondary=gold footer=compact cta=Find_the_boundary safe=clean");
socials(me);
watermark(mark,(w*0.16,h*0.055),"Made With Manic");
endcard(me,"title=Turn_Algorithms_Into_Stories cta=8gwifi.org/manic");

let u=(w+h-abs(w-h))/1080;
text(kicker,(cx,h*0.10),"COMPUTATIONAL GEOMETRY");
text(head,(cx,h*0.17),"Which points define the convex hull?");
text(caption,(cx,h*0.79),"Imagine stretching a rubber band around the cloud. Only boundary points touch it.");
size(kicker,20*u); bold(kicker); color(kicker,cyan);
size(head,27*u); bold(head); wrap(head,w*0.76);
size(caption,19*u); bold(caption); wrap(caption,w*0.74); color(caption,dim);

dot(p0,(w*0.19,h*0.52),9*u); dot(p1,(w*0.28,h*0.38),9*u); dot(p2,(w*0.47,h*0.33),9*u);
dot(p3,(w*0.70,h*0.40),9*u); dot(p4,(w*0.80,h*0.56),9*u); dot(p5,(w*0.64,h*0.66),9*u);
dot(p6,(w*0.35,h*0.67),9*u); dot(p7,(w*0.39,h*0.49),8*u); dot(p8,(w*0.53,h*0.46),8*u);
dot(p9,(w*0.62,h*0.54),8*u); dot(p10,(w*0.48,h*0.58),8*u);
tag(p0,cloud); tag(p1,cloud); tag(p2,cloud); tag(p3,cloud); tag(p4,cloud); tag(p5,cloud);
tag(p6,cloud); tag(p7,cloud); tag(p8,cloud); tag(p9,cloud); tag(p10,cloud);
color(cloud,dim);
polygon(hull,(w*0.19,h*0.52),(w*0.28,h*0.38),(w*0.47,h*0.33),(w*0.70,h*0.40),(w*0.80,h*0.56),(w*0.64,h*0.66),(w*0.35,h*0.67));
outlined(hull); outline(hull,gold); color(hull,panel); opacity(hull,0.30); stroke(hull,5);
hidden(cloud); untraced(hull); hidden(kicker); hidden(head); hidden(caption);

step("pose") {
  par { show(kicker,0.3); show(head,0.45); show(caption,0.35); }
  stagger(0.045) {
    show(p0,0.16); show(p1,0.16); show(p2,0.16); show(p3,0.16); show(p4,0.16); show(p5,0.16);
    show(p6,0.16); show(p7,0.16); show(p8,0.16); show(p9,0.16); show(p10,0.16);
  }
}
wait(0.9);
step("discard interior points") {
  par { recolor(p7,dim,0.3); recolor(p8,dim,0.3); recolor(p9,dim,0.3); recolor(p10,dim,0.3); say(caption,"Interior points cannot be touched by a supporting line, so they cannot be hull vertices.",0.45); }
}
wait(0.85);
step("test a supporting line") {
  say(caption,"A boundary point admits a line with the entire cloud on one side; an interior point never can.",0.65,smooth);
}
wait(1.0);
step("stretch the band") { par { draw(hull,1.6,smooth); say(caption,"The outermost points form the smallest convex polygon containing the entire cloud.",0.45); } }
wait(0.95);
step("read the minimal boundary") {
  par {
    pulse(hull,0.85);
    say(caption,"Removing any one hull vertex would leave an extreme point outside the polygon.",0.60,smooth);
  }
}
wait(0.95);
step("solve") { par { pulse(hull,0.75); say(head,"Seven points define the boundary.",0.4,smooth); } }
wait(1.25);
step("cta") { par { fade(kicker,0.3); fade(head,0.3); fade(caption,0.3); fade(cloud,0.3); fade(hull,0.4); fade(me.footer,0.3); show(me.endcard,0.6); } }
wait(2.2);
